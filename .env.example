# Loops (loops.so) API key for newsletter signup.
# Loops → Settings → API. The key is WORKSPACE-scoped: whichever workspace it
# belongs to is where these signups land. Unset = /api/subscribe returns a 500
# and logs the dropped address rather than failing silently.
LOOPS_API_KEY=

# Optional Loops mailing list id (Settings → Lists). Not currently used —
# signups are segmented by `source` ("tts-homepage" / "tts-footer") instead,
# which needs no configuration. Set this only if you later want contacts to be
# able to opt out of one stream without unsubscribing from everything.
LOOPS_LIST_ID=
