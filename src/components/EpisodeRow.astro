---
/**
 * One episode card.
 *
 * T8 — SINGLE DOM RENDERING. This card used to be built twice: a `hidden
 * md:grid` desktop copy and a `md:hidden` mobile copy, so every episode label,
 * title and description existed twice in the served HTML (roughly half the
 * crawlable text on the page). It now renders once and the layout switches at
 * the `md` breakpoint:
 *
 *   < md : the wrapper is a block with `py-6`; only the main cell and the
 *          stacked image block are displayed.
 *   ≥ md : the wrapper is the original `1fr 180px 1fr` grid with `gap-8`, the
 *          main / image / description cells are the three columns, and the
 *          stacked image block is display:none.
 *
 * Two `<img>` elements survive on purpose: the desktop image is a square crop
 * peeking out of a 180px column whose *wrapper height* animates 60px↔180px,
 * the mobile image is a full-width natural-ratio image whose *own max-height*
 * animates 0↔500px. One element cannot be both without changing one of the two
 * animations, and the plan's fallback is explicit — keep two images, keep one
 * copy of the text. The text is the SEO payload; `alt` is not body copy.
 *
 * The three breakpoint rules that drive the switch live in `global.css`, not in
 * this component's scoped <style>: NowPlaying's live RSS refresh re-renders
 * these rows from a string template that carries no scoped-style attribute, so
 * layout-critical CSS must be global or the layout would collapse a second
 * after load. Everything already in the scoped block below is animation/clamp
 * behaviour and is left exactly as it was.
 *
 * Class hooks the expand/collapse script targets are unchanged: `episode-row`,
 * `episode-toggle`, `episode-title`, `episode-desc`, `episode-listen-btn`,
 * `episode-image-wrapper`, `episode-mobile-image`. `buildEpisodeRow()` in
 * NowPlaying.astro mirrors this markup and must be edited in lockstep.
 */
interface Props {
  number: number | null;
  title: string;
  thumbnail: string;
  description: string;
  spotifyUrl: string;
  /**
   * `/episodes/{slug}` when this episode has a page (plan §2.7). The title
   * becomes a link to it; everything else about the card is untouched.
   *
   * `null`/absent for an episode published to the feed before its page was
   * authored — the card then renders exactly as it always has. That fallback is
   * the contract: the homepage never depends on the collection.
   *
   * The link is unstyled on purpose. Tailwind's preflight resets `a` to
   * `color: inherit; text-decoration: inherit`, so the rendered title is
   * pixel-identical; only the click target changes. The toggle handler already
   * ignores clicks that land inside an `<a>`, so the card still expands from
   * anywhere else on the row.
   */
  episodeUrl?: string | null;
  defaultExpanded?: boolean;
}

const {
  number,
  title,
  thumbnail,
  description,
  spotifyUrl,
  episodeUrl = null,
  defaultExpanded = false,
} = Astro.props;
const episodeLabel = number != null ? `Episode ${number}` : "New Episode";

// Convert title to Title Case
const titleCase = title
  .toLowerCase()
  .split(" ")
  .map((word) => {
    const small = ["a", "an", "the", "and", "but", "or", "for", "nor", "on", "at", "to", "by", "in", "of", "up"];
    return small.includes(word) ? word : word.charAt(0).toUpperCase() + word.slice(1);
  })
  .join(" ");
const formattedTitle = titleCase.charAt(0).toUpperCase() + titleCase.slice(1);

// Same glyph in both buttons — one string so they cannot drift apart.
const SPOTIFY_PATH =
  "M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z";
const listenBtnClass =
  "inline-flex items-center gap-2 bg-white/10 text-white font-bold text-xs uppercase tracking-wider px-5 py-2.5 rounded-full border border-white/20 hover:bg-white/20 transition-colors";
---

<div class="episode-row" data-expanded={defaultExpanded ? "true" : "false"}>
  <button
    class="episode-toggle w-full text-left cursor-pointer"
    aria-expanded={defaultExpanded ? "true" : "false"}
  >
    <!-- Single card: stacked < md, 3-column grid ≥ md -->
    <div class="episode-card py-6 md:py-0 md:grid md:grid-cols-[1fr_180px_1fr] md:gap-8 md:items-stretch">
      <!-- Number + Title (+ the desktop-column Spotify button) -->
      <div class="episode-cell-main flex flex-col gap-1 md:py-6">
        <span class="text-white/60 font-bold text-xs uppercase tracking-widest">{episodeLabel}</span>
        <h4 class:list={["font-normal text-white text-base md:text-lg mt-1 episode-title", defaultExpanded ? "episode-title-expanded" : "episode-title-collapsed"]}>
          {episodeUrl ? <a href={episodeUrl}>{formattedTitle}</a> : formattedTitle}
        </h4>
        <!-- Spotify button: shown only when expanded (and only ≥ md) -->
        <div class:list={["episode-listen-btn mt-4", !defaultExpanded && "hidden"]}>
          <a
            href={spotifyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={listenBtnClass}
            onclick="event.stopPropagation();"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d={SPOTIFY_PATH}/>
            </svg>
            Listen on Spotify
          </a>
        </div>
      </div>

      <!-- Desktop image: pinned to bottom of cell, peek from top -->
      <div class="hidden md:flex md:flex-col md:justify-end">
        <div class="relative overflow-hidden episode-image-wrapper rounded-t-lg" style={`height: ${defaultExpanded ? '180px' : '60px'}; transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);`}>
          <img
            src={thumbnail}
            alt={formattedTitle}
            class="w-full aspect-square object-cover object-top border border-white rounded-t-lg"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Description (desktop column; hidden < md, exactly as before) -->
      <div class="hidden md:block md:py-6">
        <p class:list={["text-text-light text-sm leading-relaxed episode-desc", defaultExpanded ? "episode-desc-expanded" : "episode-desc-collapsed"]}>
          {description}
        </p>
      </div>

      <!-- Mobile image + its Spotify button: shown only when expanded -->
      <div class:list={["episode-mobile-image mt-4", !defaultExpanded && "hidden"]}>
        <img
          src={thumbnail}
          alt={formattedTitle}
          class="w-full rounded-lg border border-white"
          loading="lazy"
        />
        <div class="mt-3">
          <a
            href={spotifyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={listenBtnClass}
            onclick="event.stopPropagation();"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d={SPOTIFY_PATH}/>
            </svg>
            Listen on Spotify
          </a>
        </div>
      </div>
    </div>
  </button>
  <!-- Divider -->
  <hr class="border-white/10" />
</div>

<style>
  .episode-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .episode-desc-collapsed {
    -webkit-line-clamp: 1;
  }
  .episode-desc-expanded {
    -webkit-line-clamp: 6;
  }
  .episode-title {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .episode-title-collapsed {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }
  .episode-title-expanded {
    -webkit-line-clamp: unset;
    overflow: visible;
  }
  .episode-listen-btn {
    display: block !important;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }
  .episode-listen-btn.hidden {
    opacity: 0;
    max-height: 0 !important;
    margin-top: 0 !important;
  }
  .episode-listen-btn:not(.hidden) {
    opacity: 1;
    max-height: 60px;
  }
  .episode-mobile-image {
    display: block !important;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }
  .episode-mobile-image.hidden {
    opacity: 0;
    max-height: 0 !important;
    margin-top: 0 !important;
  }
  .episode-mobile-image:not(.hidden) {
    opacity: 1;
    max-height: 500px;
  }
</style>
